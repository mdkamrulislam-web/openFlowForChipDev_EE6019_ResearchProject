# Pinned tool environment for the EE6019 open chip flow.
# Every tool and PDK comes from this one container image, so a run is
# reproducible on any machine that can pull it. Change it here only.
#
# Image: IIC-OSIC-TOOLS by the Institute for Integrated Circuits, JKU Linz
#   https://github.com/iic-jku/IIC-OSIC-TOOLS
# Tag 2026.09, multi-arch (amd64 + arm64), about 3.9 GB download / 17 GB on disk.
IMAGE_NAME=hpretl/iic-osic-tools
IMAGE_TAG=2026.09
IMAGE_DIGEST=sha256:b87b3f1af9ba72d9486466ea777cf4248e96e20d9dba76d67259bc185db3859c
